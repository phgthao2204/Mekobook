# ==============================================================================
# MEKOBOOK MOBILE APP - ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# Sao chep file nay thanh .env va dien thong tin may chu thuc te:
# cp .env.example .env

# Backend API Environment
# Luu y: Khong dung "localhost" khi chay tren dien thoai that, phai dung IP mang LAN hoac ngrok
# 1. Ket noi qua mang noi bo LAN:
EXPO_PUBLIC_API_BASE_URL=https://serrated-catacomb-vendor.ngrok-free.dev
EXPO_PUBLIC_STATIC_FLIPBOOK_BASE_URL=https://serrated-catacomb-vendor.ngrok-free.dev/flipbooks/

# 2. Hoac ket noi qua Internet (ngrok Tunnel):
# EXPO_PUBLIC_API_BASE_URL=https://<YOUR_NGROK_SUBDOMAIN>.ngrok-free.dev
# EXPO_PUBLIC_STATIC_FLIPBOOK_BASE_URL=https://<YOUR_NGROK_SUBDOMAIN>.ngrok-free.dev/flipbooks/

# OAuth 2.0 Client Credentials (Dang ky tren Liferay Portal 7.4 CE)
EXPO_PUBLIC_OAUTH_CLIENT_ID=your_oauth_client_id_here
# Confidential client secrets must not be embedded in EXPO_PUBLIC_ variables.
# Ask the backend administrator for a public-client/proxy authentication setup.
# An explicitly approved internal dev build may set the following locally,
# accepting that the value is extractable from the bundle. Never commit a real value.
# EXPO_PUBLIC_OAUTH_CLIENT_SECRET=
# Optional. Leave empty so Liferay uses the scopes assigned to the OAuth app.
EXPO_PUBLIC_OAUTH_SCOPE=

# Dev Test Account (Basic Auth de test nhanh tinh nang)
DEMO_USER_USERNAME=your_test_username
DEMO_USER_PASSWORD=your_test_password
DEMO_USER_ID=your_test_user_id

# Liferay Site & Scope Metadata
EXPO_PUBLIC_LIFERAY_SITE_ID=20117

# Liferay API paths
EXPO_PUBLIC_OAUTH_TOKEN_PATH=/o/oauth2/token
EXPO_PUBLIC_MY_USER_ACCOUNT_PATH=/o/headless-admin-user/v1.0/my-user-account
EXPO_PUBLIC_BOOKS_PATH=/o/c/books
EXPO_PUBLIC_CHAPTER_TOCS_PATH=/o/c/chaptertocs
EXPO_PUBLIC_PERSONAL_SHELFS_PATH=/o/c/personalshelfs
EXPO_PUBLIC_SHELF_ITEMS_PATH=/o/c/shelfitems
EXPO_PUBLIC_USER_PREFERENCES_PATH=/o/c/userpreferences
EXPO_PUBLIC_READING_PROGRESSES_PATH=/o/c/readingprogresses
EXPO_PUBLIC_BOOKMARKS_PATH=/o/c/bookmarks
EXPO_PUBLIC_ANNOTATIONS_PATH=/o/c/annotations
EXPO_PUBLIC_DRM_LICENSES_PATH=/o/c/drmlicenses
EXPO_PUBLIC_DEVICE_REGISTRATIONS_PATH=/o/c/deviceregistrations
DM_ROOT_FOLDER_ID=32804
DM_COVERS_FOLDER_ID=32806
DM_ORIGINALS_FOLDER_ID=32808
DM_ZIPS_FOLDER_ID=32810

# Flipbook Engine Performance & Pre-caching Settings
CACHE_SLIDING_WINDOW_SIZE=4
MAX_GPU_MEMORY_MB=40
TARGET_FRAME_RATE=60

# DRM & Security Settings
ENABLE_FLAG_SECURE=true
ENABLE_WATERMARK=false
OFFLINE_ENCRYPTION_ALGORITHM=AES-256-GCM
