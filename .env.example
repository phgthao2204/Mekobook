# ==============================================================================
# MEKOBOOK MOBILE APP - ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# Sao chep file nay thanh .env va dien thong tin may chu thuc te:
# cp .env.example .env

# Backend API Environment
# Luu y: Khong dung "localhost" khi chay tren dien thoai that, phai dung IP mang LAN hoac ngrok
# 1. Ket noi qua mang noi bo LAN:
API_BASE_URL=http://<YOUR_LIFERAY_IP>:8080
STATIC_FLIPBOOK_BASE_URL=http://<YOUR_LIFERAY_IP>:8080/flipbooks/

# 2. Hoac ket noi qua Internet (ngrok Tunnel):
# API_BASE_URL=https://<YOUR_NGROK_SUBDOMAIN>.ngrok-free.dev
# STATIC_FLIPBOOK_BASE_URL=https://<YOUR_NGROK_SUBDOMAIN>.ngrok-free.dev/flipbooks/

# OAuth 2.0 Client Credentials (Dang ky tren Liferay Portal 7.4 CE)
OAUTH_TOKEN_URL=/o/oauth2/token
OAUTH_CLIENT_ID=your_oauth_client_id_here
OAUTH_CLIENT_SECRET=your_oauth_client_secret_here

# Dev Test Account (Basic Auth de test nhanh tinh nang)
DEMO_USER_USERNAME=your_test_username
DEMO_USER_PASSWORD=your_test_password
DEMO_USER_ID=your_test_user_id

# Liferay Site & Scope Metadata
LIFERAY_SITE_ID=20117
DM_ROOT_FOLDER_ID=32804
DM_COVERS_FOLDER_ID=32806
DM_ORIGINALS_FOLDER_ID=32808
DM_ZIPS_FOLDER_ID=32810

# Flipbook Engine Performance & Pre-caching Settings
CACHE_SLIDING_WINDOW_SIZE=4
MAX_GPU_MEMORY_MB=40
TARGET_FRAME_RATE=60

# DRM & Security Settings
ENABLE_FLAG_SECURE=true
ENABLE_WATERMARK=false
OFFLINE_ENCRYPTION_ALGORITHM=AES-256-GCM
